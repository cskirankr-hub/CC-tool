      total:        rows.length,
      active:       active.length,
      pipeline:     rows.filter(x=>OPEN.includes(x.status)).length,
      expiringSoon: active.filter(x=>x.expiry && daysFrom(x.expiry)>=0 && daysFrom(x.expiry)<=60).length,
      needsAction:  rows.filter(x=>x.status==="expired").length + overdueActive.length,
      value:        active.reduce((s,x)=>s+(Number(x.value)||0),0),
    };
  },[rows]);
  const score = rows.length ? Math.round(cs.active/cs.total*100) : 0;

  const catStats = useMemo(()=>Object.keys(CATS).map(c=>{
    const r=rows.filter(x=>x.cat===c);
    const active=r.filter(x=>x.status==="active").length;
    const expiringSoon=r.filter(x=>x.status==="active"&&x.expiry&&daysFrom(x.expiry)>=0&&daysFrom(x.expiry)<=60).length;
    const needsAction=r.filter(x=>x.status==="expired"||(x.status==="active"&&x.expiry&&daysFrom(x.expiry)<0)).length;
    return {c, total:r.length, active, expiringSoon, needsAction,
      score:r.length?Math.round(active/r.length*100):0};
  }),[rows]);

  const urgent = useMemo(()=>rows
    .filter(x=>!CLOSED.includes(x.status)&&x.status!=="draft"&&x.status!=="review"&&x.status!=="signature"&&x.expiry&&daysFrom(x.expiry)<=60)
