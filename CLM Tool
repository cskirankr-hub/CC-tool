  const filtC = useMemo(()=>rows.filter(x=>
    (tCat==="ALL"||x.cat===tCat)&&
    (tSt==="ALL"||x.status===tSt)&&
    (!tQ||x.title.toLowerCase().includes(tQ.toLowerCase())||x.party.toLowerCase().includes(tQ.toLowerCase())||x.type.toLowerCase().includes(tQ.toLowerCase()))
