  const showToast = (msg, type="success") => {
    setToast({msg,type});
    setTimeout(()=>setToast(null), 2800);
  };

  const openAdd = () => { setForm(blankForm()); setModal("add"); };
  const openEdit = row => { setForm({...row, value: row.value || ""}); setModal(row.id); };
