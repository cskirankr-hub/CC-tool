            <div style={{display:"grid",gridTemplateColumns:"repeat(2,1fr)",gap:18}}>
              {[{m:9,y:2026,n:"September 2026"},{m:10,y:2026,n:"October 2026"},{m:11,y:2026,n:"November 2026"},{m:12,y:2026,n:"December 2026"}].map(({m,y,n})=>{
                const items=rows.filter(x=>{ if(!x.expiry) return false; const d=new Date(x.expiry); return d.getMonth()+1===m && d.getFullYear()===y; })
                  .sort((a,b)=>new Date(a.expiry)-new Date(b.expiry));
                return (
                  <div key={`${m}-${y}`} style={{...card}}>
                    <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:16}}>
                      <h3 style={{margin:0,fontSize:15,fontWeight:800,color:"#0f172a"}}>📅 {n}</h3>
                      <span style={{background:"#e0f2fe",color:"#0284c7",borderRadius:8,padding:"3px 10px",fontSize:11,fontWeight:700}}>{items.length} key dates</span>
                    </div>
                    {items.length===0
                      ? <div style={{color:"#94a3b8",textAlign:"center",padding:"24px 0",fontSize:13}}>No renewals or key dates this month</div>
                      : items.map((x,i)=>{
                          const d=new Date(x.expiry);
                          const sc=ST[x.status]||ST.draft;
                          return (
                            <div key={i} onClick={()=>{openEdit(x);}}
                              style={{display:"flex",gap:12,padding:"10px 8px",borderBottom:"1px solid #f1f5f9",
                                alignItems:"flex-start",cursor:"pointer",borderRadius:8,transition:"background 0.12s"}}
                              onMouseEnter={e=>e.currentTarget.style.background="#f0f4ff"}
                              onMouseLeave={e=>e.currentTarget.style.background="transparent"}>
                              <div style={{flexShrink:0,width:38,textAlign:"center",background:"#f8fafc",borderRadius:8,padding:"4px 0"}}>
                                <div style={{fontWeight:900,fontSize:18,color:"#0f172a",lineHeight:1}}>{d.getDate()}</div>
                                <div style={{fontSize:8,color:"#94a3b8",letterSpacing:"0.5px",textTransform:"uppercase"}}>{n.split(" ")[0].slice(0,3)}</div>
                              </div>
                              <div style={{flex:1}}>
                                <div style={{fontSize:12,fontWeight:600,color:"#111827"}}>{x.title}</div>
                                <div style={{fontSize:10,color:"#64748b",marginTop:1}}>{x.party}</div>
                                <div style={{display:"flex",gap:5,marginTop:4,flexWrap:"wrap"}}>
                                  <Badge cat={x.cat}/>
                                  <span style={{background:sc.bg,color:sc.color,borderRadius:4,padding:"1px 6px",fontSize:9,fontWeight:700}}>{sc.icon} {sc.label}</span>
                                </div>
                              </div>
                              <DaysChip due={x.expiry} status={x.status}/>
                            </div>
                          );
                      })
                    }
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* ══ PORTFOLIO REPORT ══ */}
        {tab==="cover"&&(
          <div style={{maxWidth:900,margin:"0 auto"}}>
            <div style={{...card,padding:0,overflow:"hidden",boxShadow:"0 8px 40px rgba(0,0,0,0.13)"}}>
              <div style={{background:"linear-gradient(135deg,#0f172a,#1e3a8a,#0c4a6e)",padding:"48px 56px",textAlign:"center"}}>
                <div style={{fontSize:40}}>📑</div>
                <div style={{color:"#fff",fontSize:26,fontWeight:900,marginTop:14,letterSpacing:"-0.5px"}}>AGREEMENT PORTFOLIO STATUS REPORT</div>
                <div style={{color:"#93c5fd",fontSize:14,marginTop:6}}>Contract Lifecycle Management · Financial Year {FY}</div>
                <div style={{color:"#60a5fa",fontSize:12,marginTop:3}}>Prepared as on 20 September 2026</div>
                <div style={{display:"inline-block",marginTop:20,
                  background:score>=75?"#059669":score>=50?"#d97706":"#dc2626",
                  color:"#fff",borderRadius:30,padding:"10px 32px",fontWeight:900,fontSize:22}}>
                  Active Rate: {score}% · Portfolio Value: {fmtCr(cs.value)}
                </div>
              </div>
              <div style={{padding:"40px 56px"}}>
                {/* Summary table */}
                <h3 style={{fontSize:13,fontWeight:800,color:"#0f172a",borderBottom:"2px solid #e2e8f0",paddingBottom:8,marginBottom:16,letterSpacing:"0.3px"}}>I. AGREEMENT CATEGORY SUMMARY</h3>
                <table style={{width:"100%",borderCollapse:"collapse",fontSize:12,marginBottom:32}}>
                  <thead>
                    <tr style={{background:"#f8fafc"}}>
                      {["Category","Description","Total","Active","Expiring ≤60d","Needs Renewal","Active Rate"].map(h=>(
                        <th key={h} style={{padding:"9px 13px",textAlign:h==="Category"||h==="Description"?"left":"center",
                          fontSize:10,fontWeight:700,color:"#64748b",border:"1px solid #e2e8f0"}}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {catStats.map(({c,total,active,expiringSoon,needsAction,score:sc})=>(
                      <tr key={c} style={{background:total?"#fff":"#fafbfc"}}>
                        <td style={{padding:"9px 13px",border:"1px solid #e2e8f0",fontWeight:800,color:CATS[c].color}}>{c}</td>
                        <td style={{padding:"9px 13px",border:"1px solid #e2e8f0",fontSize:11,color:"#6b7280"}}>{CATS[c].label}</td>
                        {[total,active,expiringSoon,needsAction].map((v,j)=>(
                          <td key={j} style={{padding:"9px 13px",border:"1px solid #e2e8f0",textAlign:"center",fontWeight:600,
                            color:j===3&&v>0?"#dc2626":"#374151"}}>{v}</td>
                        ))}
                        <td style={{padding:"9px 13px",border:"1px solid #e2e8f0",textAlign:"center",fontWeight:800,
                          color:sc>=75?"#059669":sc>=50?"#d97706":"#dc2626"}}>{sc}%</td>
                      </tr>
                    ))}
                    <tr style={{background:"#e0f2fe"}}>
                      <td colSpan={2} style={{padding:"9px 13px",border:"1px solid #e2e8f0",fontWeight:900,color:"#0f172a"}}>TOTAL</td>
                      {[cs.total,cs.active,cs.expiringSoon,cs.needsAction].map((v,i)=>(
                        <td key={i} style={{padding:"9px 13px",border:"1px solid #e2e8f0",textAlign:"center",fontWeight:900,
                          color:i===3&&v>0?"#dc2626":"#0f172a"}}>{v}</td>
                      ))}
                      <td style={{padding:"9px 13px",border:"1px solid #e2e8f0",textAlign:"center",fontWeight:900,
                        color:score>=75?"#059669":score>=50?"#d97706":"#dc2626"}}>{score}%</td>
                    </tr>
                  </tbody>
                </table>

                {/* Needs renewal */}
                {rows.filter(x=>x.status==="expired"||(x.status==="active"&&x.expiry&&daysFrom(x.expiry)<0)).length>0&&(
                  <>
                    <h3 style={{fontSize:13,fontWeight:800,color:"#dc2626",borderBottom:"2px solid #fee2e2",paddingBottom:8,marginBottom:16}}>II. CONTRACTS REQUIRING IMMEDIATE ATTENTION</h3>
                    {rows.filter(x=>x.status==="expired"||(x.status==="active"&&x.expiry&&daysFrom(x.expiry)<0)).map(t=>(
                      <div key={t.id} style={{background:"#fef2f2",border:"1px solid #fecaca",borderRadius:10,padding:"12px 16px",marginBottom:10}}>
                        <div style={{display:"flex",justifyContent:"space-between"}}>
                          <span style={{fontWeight:700,fontSize:12,color:"#991b1b"}}>{t.title}</span>
                          <Badge cat={t.cat}/>
                        </div>
                        <div style={{fontSize:11,color:"#6b7280",marginTop:3}}>{t.party} · Expiry: {fmtDate(t.expiry)} · {t.remarks||"No remarks"}</div>
                      </div>
                    ))}
                    <div style={{marginBottom:24}}/>
                  </>
                )}

                {/* Pipeline */}
                {rows.filter(x=>OPEN.includes(x.status)).length>0&&(
                  <>
                    <h3 style={{fontSize:13,fontWeight:800,color:"#d97706",borderBottom:"2px solid #fef3c7",paddingBottom:8,marginBottom:16}}>
                      {rows.filter(x=>x.status==="expired"||(x.status==="active"&&x.expiry&&daysFrom(x.expiry)<0)).length>0?"III":"II"}. PIPELINE — DRAFT / UNDER REVIEW / PENDING SIGNATURE
                    </h3>
                    <table style={{width:"100%",borderCollapse:"collapse",fontSize:11,marginBottom:32}}>
                      <thead>
                        <tr style={{background:"#fffbeb"}}>
                          {["Cat.","Title","Counterparty","Status","Target Date","Remarks"].map(h=>(
                            <th key={h} style={{padding:"7px 11px",textAlign:"left",fontWeight:700,color:"#92400e",border:"1px solid #fef3c7",fontSize:10}}>{h}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {rows.filter(x=>OPEN.includes(x.status)).map((t,i)=>(
                          <tr key={t.id} style={{background:i%2===0?"#fff":"#fffbeb"}}>
                            <td style={{padding:"7px 11px",border:"1px solid #fef3c7"}}><Badge cat={t.cat}/></td>
                            <td style={{padding:"7px 11px",border:"1px solid #fef3c7",fontWeight:600}}>{t.title}</td>
                            <td style={{padding:"7px 11px",border:"1px solid #fef3c7",color:"#6b7280"}}>{t.party}</td>
                            <td style={{padding:"7px 11px",border:"1px solid #fef3c7"}}><Pill s={t.status}/></td>
                            <td style={{padding:"7px 11px",border:"1px solid #fef3c7",whiteSpace:"nowrap"}}>{fmtDate(t.expiry)}</td>
                            <td style={{padding:"7px 11px",border:"1px solid #fef3c7",color:"#6b7280"}}>{t.remarks}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </>
                )}

                {/* Certification */}
                <div style={{marginTop:32,borderTop:"2px solid #e2e8f0",paddingTop:28}}>
                  <h3 style={{fontSize:12,fontWeight:800,color:"#1e293b",marginBottom:12}}>CERTIFICATION</h3>
                  <p style={{fontSize:11,color:"#475569",lineHeight:1.9,fontStyle:"italic",background:"#f8fafc",padding:"16px 20px",borderRadius:10,border:"1px solid #e2e8f0"}}>
                    This Agreement Portfolio Status Report has been prepared based on the contract register maintained by the Company and information provided by respective business owners. The status indicated represents the position as on <strong>20 September 2026</strong> and is prepared for internal contract lifecycle monitoring and governance purposes. This report does not constitute legal advice and does not replace review of the underlying executed agreements.
                  </p>
                  <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:48,marginTop:40}}>
                    {["Legal / Company Secretary","Contract Owner","CFO / Finance Head"].map(r=>(
                      <div key={r} style={{borderTop:"1.5px solid #1e293b",paddingTop:8,textAlign:"center"}}>
                        <div style={{fontSize:12,fontWeight:700,color:"#1e293b"}}>{r}</div>
                        <div style={{fontSize:10,color:"#94a3b8",marginTop:2}}>Signature & Date</div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
            <div style={{textAlign:"center",marginTop:18}}>
              <button onClick={()=>window.print()} style={{background:"#0f172a",color:"#fff",border:"none",borderRadius:10,
                padding:"12px 32px",fontSize:13,fontWeight:700,cursor:"pointer"}}>🖨️ Print / Export Report</button>
            </div>
          </div>
        )}
      </div>

      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap');
        *{box-sizing:border-box;} body{margin:0;}
        @keyframes blink{0%,100%{opacity:1}50%{opacity:0.6}}
        @keyframes slideUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
        @keyframes slideIn{from{opacity:0;transform:translateX(20px)}to{opacity:1;transform:translateX(0)}}
        select{outline:none;} input:focus{outline:2px solid #1e3a8a;outline-offset:1px;}
        ::-webkit-scrollbar{width:5px;height:5px} ::-webkit-scrollbar-track{background:#f1f5f9}
        ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:99px}
        @media print{button{display:none!important}}
      `}</style>
    </div>
  );
}
