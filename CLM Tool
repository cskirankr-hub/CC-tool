                    <div style={{position:"relative",width:52,height:52}}>
                      <CircleG pct={sc} size={52} w={5}/>
                      <div style={{position:"absolute",top:"50%",left:"50%",transform:"translate(-50%,-50%)",fontSize:10,fontWeight:800,color:"#1e293b"}}>{sc}%</div>
                    </div>
                  </div>
                  <div style={{display:"flex",gap:6,marginTop:10,flexWrap:"wrap"}}>
                    <span style={{background:"#d1fae5",color:"#065f46",borderRadius:6,padding:"2px 8px",fontSize:10,fontWeight:700}}>✓{active}</span>
                    {needsAction>0&&<span style={{background:"#fee2e2",color:"#991b1b",borderRadius:6,padding:"2px 8px",fontSize:10,fontWeight:700}}>⚠{needsAction}</span>}
                    {expiringSoon>0&&<span style={{background:"#fef3c7",color:"#92400e",borderRadius:6,padding:"2px 8px",fontSize:10,fontWeight:700}}>⏳{expiringSoon}</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ══ TRACKER ══ */}
        {tab==="track"&&(
          <div>
            {/* Toolbar */}
            <div style={{...card,padding:"14px 18px",marginBottom:16,display:"flex",gap:10,flexWrap:"wrap",alignItems:"center"}}>
              <input value={tQ} onChange={e=>setTQ(e.target.value)} placeholder="🔍 Search title, counterparty or type..."
                style={{border:"1px solid #e2e8f0",borderRadius:9,padding:"8px 14px",fontSize:12,flex:1,minWidth:180,outline:"none"}}/>
              <div style={{display:"flex",gap:5,flexWrap:"wrap"}}>
                {["ALL",...Object.keys(CATS)].map(c=>(
                  <button key={c} onClick={()=>setTCat(c)}
                    style={{padding:"6px 13px",borderRadius:7,border:"none",cursor:"pointer",fontSize:11,fontWeight:700,
                      background:tCat===c?(c==="ALL"?"#0f172a":CATS[c]?.color):"#f1f5f9",
                      color:tCat===c?"#fff":"#64748b",transition:"all 0.15s"}}>{c}</button>
                ))}
              </div>
              <div style={{display:"flex",gap:5,flexWrap:"wrap"}}>
                {["ALL",...Object.keys(ST)].map(s=>(
                  <button key={s} onClick={()=>setTSt(s)}
                    style={{padding:"6px 11px",borderRadius:7,border:"none",cursor:"pointer",fontSize:10,fontWeight:700,textTransform:"capitalize",
                      background:tSt===s?(s==="ALL"?"#0f172a":ST[s]?.color||"#0284c7"):"#f1f5f9",
                      color:tSt===s?"#fff":"#64748b",transition:"all 0.15s"}}>{s}</button>
