                            <div style={{ flex:1, minWidth:0 }}>
                              <div style={{ fontSize:12, fontWeight:600, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>{t.topic}</div>
                              <div style={{ fontSize:10, color:"#64748b" }}>{t.subject} · {fmtDate(t.target)}</div>
                            </div>
                            <PriorityPill p={t.priority} />
                            <div style={{ fontSize:12, fontWeight:800, color: d <= 0 ? "#dc2626" : d <= 3 ? "#d97706" : "#4f46e5", flexShrink:0 }}>
                              {d <= 0 ? `${Math.abs(d)}d late` : `${d}d`}
                            </div>
                          </div>
