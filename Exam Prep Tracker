// ── INLINE EDIT CELL ──────────────────────────────────────────────────────────
function EditCell({ value, onChange, type = "text", options }) {
  const [editing, setEditing] = useState(false);
  const [val, setVal] = useState(value);
  const commit = () => { onChange(type === "number" ? Number(val) : val); setEditing(false); };
  if (!editing) return (
    <span onClick={() => setEditing(true)}
      style={{ cursor:"text", borderRadius:5, padding:"2px 5px", display:"inline-block", border:"1px dashed transparent", minWidth:40, fontSize:12, color:"#374151" }}
      onMouseEnter={e => e.target.style.borderColor = "#cbd5e1"} onMouseLeave={e => e.target.style.borderColor = "transparent"}>
      {value === "" || value === undefined ? <span style={{ color:"#94a3b8", fontStyle:"italic" }}>click to edit</span> : String(value)}
    </span>
  );
  if (options) return (
    <select autoFocus value={val} onChange={e => setVal(e.target.value)} onBlur={commit}
      style={{ border:"1.5px solid #0284c7", borderRadius:6, padding:"3px 6px", fontSize:11, background:"#fff", outline:"none" }}>
      {options.map(o => <option key={o.v} value={o.v}>{o.l}</option>)}
    </select>
  );
  if (type === "date" || type === "number") return (
    <input autoFocus type={type} value={val} onChange={e => setVal(e.target.value)} onBlur={commit} onKeyDown={e => e.key === "Enter" && commit()}
      style={{ border:"1.5px solid #0284c7", borderRadius:6, padding:"3px 7px", fontSize:11, outline:"none", width:type === "number" ? 70 : "auto" }} />
  );
  return (
    <input autoFocus value={val} onChange={e => setVal(e.target.value)} onBlur={commit} onKeyDown={e => e.key === "Enter" && commit()}
      style={{ border:"1.5px solid #0284c7", borderRadius:6, padding:"3px 7px", fontSize:11, outline:"none", width:"100%", minWidth:120 }} />
  );
}

