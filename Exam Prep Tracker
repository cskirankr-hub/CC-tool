                ➕ Add Topic
              </button>
            </div>
          </div>
          <div style={{ display:"flex", gap:2, marginTop:12, overflowX:"auto" }}>
            {[{ id:"dash", label:"📊 Dashboard" }, { id:"topics", label:"📋 Topics" }, { id:"mocks", label:"📝 Mock Tests" }, { id:"cal", label:"📅 Calendar" }, { id:"report", label:"📄 Report" }].map(t => (
              <button key={t.id} onClick={() => setTab(t.id)} style={tabBtn(t.id)}>{t.label}</button>
            ))}
          </div>
        </div>
      </div>

      <div style={{ maxWidth:1320, margin:"0 auto", padding:"26px 28px" }}>

        {/* ══ DASHBOARD ══ */}
