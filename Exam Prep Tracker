                </div>
              </div>
            </div>
            <div style={{ display:"flex", alignItems:"center", gap:10, flexWrap:"wrap" }}>
              <div style={{ background:"rgba(255,255,255,0.08)", borderRadius:10, padding:"8px 16px", textAlign:"center" }}>
                <div style={{ color:"#7dd3fc", fontSize:10, letterSpacing:"0.5px" }}>DAYS TO GO</div>
                <div style={{ color: daysLeft <= 7 ? "#f87171" : "#fff", fontSize:18, fontWeight:800 }}>{daysLeft < 0 ? "Exam over" : daysLeft}</div>
              </div>
              <div style={{ background:"rgba(255,255,255,0.08)", borderRadius:10, padding:"8px 16px", textAlign:"center" }}>
                <div style={{ color:"#7dd3fc", fontSize:10 }}>READINESS</div>
                <div style={{ color: readiness >= 75 ? "#4ade80" : readiness >= 50 ? "#fbbf24" : "#f87171", fontSize:18, fontWeight:800 }}>{readiness}%</div>
              </div>
              <button onClick={openAdd}
