                      <div style={{ width:`${score}%`, height:"100%", background:colorFor(s).color, borderRadius:99, transition:"width 1s" }} />
                    </div>
                    <div style={{ fontSize:10, color:"#94a3b8", marginTop:3 }}>✓{mastered} mastered · {total} total</div>
