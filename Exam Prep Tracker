                </div>
              </div>
            </div>

            <div style={{ display:"grid", gridTemplateColumns:`repeat(${Math.max(subjectStats.length, 1)},1fr)`, gap:14 }}>
              {subjectStats.map(({ s, total, mastered, behind, score }) => (
                <div key={s} onClick={() => { setTSubj(s); setTab("topics"); }}
                  style={{ background:`linear-gradient(135deg,${colorFor(s).color}18,${colorFor(s).color}05)`, border:`1.5px solid ${colorFor(s).color}30`, borderRadius:16, padding:"18px 20px", cursor:"pointer" }}>
                  <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start" }}>
                    <div>
                      <div style={{ fontWeight:800, fontSize:13, color:colorFor(s).color, maxWidth:130 }}>{s}</div>
                      <div style={{ fontSize:10, color:"#64748b", marginTop:1 }}>{total} topics</div>
                    </div>
                    <div style={{ position:"relative", width:56, height:56 }}>
                      <CircleG pct={score} size={56} w={5} />
                      <div style={{ position:"absolute", top:"50%", left:"50%", transform:"translate(-50%,-50%)", fontSize:10, fontWeight:800, color:"#1e293b" }}>{score}%</div>
                    </div>
                  </div>
                  <div style={{ display:"flex", gap:6, marginTop:10, flexWrap:"wrap" }}>
                    <span style={{ background:"#d1fae5", color:"#065f46", borderRadius:6, padding:"2px 8px", fontSize:10, fontWeight:700 }}>✓{mastered}</span>
                    {behind > 0 && <span style={{ background:"#fee2e2", color:"#991b1b", borderRadius:6, padding:"2px 8px", fontSize:10, fontWeight:700 }}>⚠{behind}</span>}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* ══ TOPICS ══ */}
        {tab === "topics" && (
          <div>
            <div style={{ ...card, padding:"14px 18px", marginBottom:16, display:"flex", gap:10, flexWrap:"wrap", alignItems:"center" }}>
              <input value={tQ} onChange={e => setTQ(e.target.value)} placeholder="🔍 Search topic or subject..." style={{ border:"1px solid #e2e8f0", borderRadius:9, padding:"8px 14px", fontSize:12, flex:1, minWidth:180, outline:"none" }} />
              <select value={tSubj} onChange={e => setTSubj(e.target.value)} style={{ ...inputStyle, width:"auto", padding:"7px 10px" }}>
                <option value="ALL">All Subjects</option>
                {subjects.map(s => <option key={s} value={s}>{s}</option>)}
              </select>
              <div style={{ display:"flex", gap:5, flexWrap:"wrap" }}>
                {["ALL", "notstarted", "inprogress", "revision", "mastered"].map(s => (
                  <button key={s} onClick={() => setTSt(s)}
                    style={{ padding:"6px 11px", borderRadius:7, border:"none", cursor:"pointer", fontSize:10, fontWeight:700, background: tSt === s ? (s === "ALL" ? "#0f172a" : ST[s]?.color) : "#f1f5f9", color: tSt === s ? "#fff" : "#64748b" }}>
                    {s === "ALL" ? "ALL" : ST[s].label}
                  </button>
                ))}
              </div>
              <div style={{ display:"flex", gap:5 }}>
                {["ALL", "High", "Medium", "Low"].map(p => (
                  <button key={p} onClick={() => setTPri(p)}
                    style={{ padding:"6px 11px", borderRadius:7, border:"none", cursor:"pointer", fontSize:10, fontWeight:700, background: tPri === p ? (p === "ALL" ? "#0f172a" : PRI[p]?.color) : "#f1f5f9", color: tPri === p ? "#fff" : "#64748b" }}>
                    {p}
                  </button>
                ))}
              </div>
              <button onClick={openAdd} style={{ background:"linear-gradient(135deg,#0284c7,#0d9488)", color:"#fff", border:"none", borderRadius:9, padding:"8px 16px", fontSize:12, fontWeight:700, cursor:"pointer", whiteSpace:"nowrap" }}>➕ Add New</button>
            </div>

            <div style={{ background:"#fffbeb", border:"1px solid #fef3c7", borderRadius:10, padding:"8px 16px", marginBottom:12, fontSize:11, color:"#92400e" }}>
              💡 <strong>Inline editing:</strong> Click any cell to edit directly. Use ✏️ for a full edit, 🗑️ to delete.
            </div>

            <div style={{ ...card, padding:0, overflow:"hidden" }}>
              <div style={{ overflowX:"auto" }}>
                <table style={{ width:"100%", borderCollapse:"collapse", minWidth:1100 }}>
                  <thead>
                    <tr>
                      {["#", "Subject", "Topic", "Priority", "Target Date", "Days", "Status", "Hrs (done/planned)", "Notes", "Actions"].map((h, i) => (
                        <TH key={i} center={i >= 5 && i <= 7}>{h}</TH>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {filtT.map((t, i) => (
                      <tr key={t.id} style={{ background: i % 2 === 0 ? "#fff" : "#fafbfc" }}>
                        <td style={{ padding:"10px 12px", borderBottom:"1px solid #f1f5f9", fontSize:11, color:"#94a3b8", fontWeight:600 }}>{i + 1}</td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", maxWidth:160 }}>
                          <EditCell value={t.subject} onChange={v => updateField(t.id, "subject", v)} />
                        </td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", maxWidth:220 }}>
                          <EditCell value={t.topic} onChange={v => updateField(t.id, "topic", v)} />
                        </td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9" }}>
                          <EditCell value={t.priority} onChange={v => updateField(t.id, "priority", v)} options={Object.keys(PRI).map(p => ({ v:p, l:p }))} />
                        </td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9" }}>
                          <EditCell value={t.target} type="date" onChange={v => updateField(t.id, "target", v)} />
                        </td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", textAlign:"center" }}>
                          <DaysChip due={t.target} status={t.status} />
                        </td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", textAlign:"center" }}>
                          <select value={t.status} onChange={e => updateField(t.id, "status", e.target.value)}
                            style={{ border:"1.5px solid #e2e8f0", borderRadius:7, padding:"4px 8px", fontSize:11, cursor:"pointer", background:ST[t.status]?.bg, color:ST[t.status]?.color, fontWeight:700, outline:"none" }}>
                            {Object.entries(ST).map(([k, v]) => <option key={k} value={k}>{v.icon} {v.label}</option>)}
                          </select>
                        </td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", textAlign:"center", fontSize:11 }}>
                          <EditCell value={t.hoursDone} type="number" onChange={v => updateField(t.id, "hoursDone", v)} /> / <EditCell value={t.hoursPlanned} type="number" onChange={v => updateField(t.id, "hoursPlanned", v)} />
                        </td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", maxWidth:160 }}>
                          <EditCell value={t.notes} onChange={v => updateField(t.id, "notes", v)} />
