// ── MINI UI ──────────────────────────────────────────────────────────────────
const SubjectBadge = ({ subject }) => {
  const c = colorFor(subject);
  return <span style={{ background:c.light, color:c.color, borderRadius:5, padding:"2px 9px", fontSize:10, fontWeight:700, whiteSpace:"nowrap", display:"inline-block", maxWidth:150, overflow:"hidden", textOverflow:"ellipsis" }}>{subject}</span>;
};
const PriorityPill = ({ p }) => {
  const c = PRI[p] || PRI.Medium;
  return <span style={{ background:c.bg, color:c.color, borderRadius:6, padding:"2px 9px", fontSize:10, fontWeight:700 }}>{p}</span>;
};
const StatusPill = ({ s }) => {
  const c = ST[s] || ST.notstarted;
  return <span style={{ background:c.bg, color:c.color, borderRadius:6, padding:"3px 10px", fontSize:11, fontWeight:700, whiteSpace:"nowrap" }}>{c.icon} {c.label}</span>;
};
const DaysChip = ({ due, status }) => {
  if (status === "mastered") return <span style={{ color:"#94a3b8", fontSize:12 }}>—</span>;
  const d = daysFrom(due);
  const col = d < 0 ? "#dc2626" : d <= 3 ? "#d97706" : d <= 14 ? "#4f46e5" : "#059669";
  return <span style={{ fontWeight:700, fontSize:12, color:col }}>{d < 0 ? `${Math.abs(d)}d behind` : d === 0 ? "today" : `${d}d`}</span>;
};
const CircleG = ({ pct, size = 64, w = 6 }) => {
  const r = (size - w) / 2, ci = 2 * Math.PI * r, off = ci - (pct / 100) * ci;
  const col = pct >= 75 ? "#059669" : pct >= 45 ? "#d97706" : "#dc2626";
  return (
    <svg width={size} height={size} style={{ transform:"rotate(-90deg)" }}>
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke="#e2e8f0" strokeWidth={w} />
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={col} strokeWidth={w}
        strokeDasharray={ci} strokeDashoffset={off} strokeLinecap="round" style={{ transition:"stroke-dashoffset 0.9s" }} />
    </svg>
  );
};

