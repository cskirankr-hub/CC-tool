      {settingsOpen && (
        <ExamSettingsModal name={examName} date={examDate}
          onSave={(n, d) => { setExamName(n); setExamDate(d); setSettingsOpen(false); showToast("🎯 Exam details updated"); }}
          onClose={() => setSettingsOpen(false)} />
