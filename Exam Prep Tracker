const PALETTE = [
  { color:"#4f46e5", light:"#eef2ff" },
  { color:"#0284c7", light:"#e0f2fe" },
  { color:"#7c3aed", light:"#f5f3ff" },
  { color:"#be185d", light:"#fdf2f8" },
