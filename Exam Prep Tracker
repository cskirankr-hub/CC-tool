    revision: topics.filter(x => x.status === "revision").length,
    notstarted: topics.filter(x => x.status === "notstarted").length,
  }), [topics]);
  const readiness = topics.length ? Math.round((cs.mastered / topics.length) * 100) : 0;
  const hoursLogged = topics.reduce((s, t) => s + (Number(t.hoursDone) || 0), 0);
  const avgMock = mocks.length ? Math.round(mocks.reduce((s, m) => s + (m.score / m.max) * 100, 0) / mocks.length) : 0;

  const subjectStats = useMemo(() => subjects.map(s => {
    const r = topics.filter(x => x.subject === s);
    const mastered = r.filter(x => x.status === "mastered").length;
    return { s, total: r.length, mastered, behind: r.filter(x => x.status !== "mastered" && daysFrom(x.target) < 0).length, score: r.length ? Math.round((mastered / r.length) * 100) : 0 };
  }).filter(x => x.total > 0), [subjects, topics]);

  const focusNow = useMemo(() => topics
    .filter(x => x.status !== "mastered" && (x.priority === "High" || daysFrom(x.target) <= 7))
    .sort((a, b) => daysFrom(a.target) - daysFrom(b.target)).slice(0, 8), [topics]);

  const filtT = useMemo(() => topics.filter(x =>
    (tSubj === "ALL" || x.subject === tSubj) &&
    (tSt === "ALL" || x.status === tSt) &&
    (tPri === "ALL" || x.priority === tPri) &&
    (!tQ || x.topic.toLowerCase().includes(tQ.toLowerCase()) || x.subject.toLowerCase().includes(tQ.toLowerCase()))
  ), [topics, tSubj, tSt, tPri, tQ]);

  const sortedMocks = useMemo(() => [...mocks].sort((a, b) => new Date(a.date) - new Date(b.date)), [mocks]);

  const card = { background:"#fff", borderRadius:16, boxShadow:"0 1px 10px rgba(0,0,0,0.07)", padding:"22px 24px" };
  const tabBtn = (id) => ({
    padding:"11px 20px", border:"none", cursor:"pointer", fontSize:12.5, fontWeight:600,
    background: tab === id ? "#fff" : "transparent",
    color: tab === id ? "#0f172a" : "#94c4dd",
    borderRadius:"8px 8px 0 0", transition:"all 0.18s",
    borderBottom: tab === id ? "3px solid #0284c7" : "3px solid transparent", whiteSpace:"nowrap",
