                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", fontWeight:600 }}>{m.name}</td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", color:"#64748b" }}>{fmtDate(m.date)}</td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", textAlign:"center" }}>{m.score}/{m.max}</td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", textAlign:"center", fontWeight:800, color: pct >= 60 ? "#059669" : pct >= 40 ? "#d97706" : "#dc2626" }}>{pct}%</td>
                        <td style={{ padding:"10px 14px", borderBottom:"1px solid #f1f5f9", textAlign:"center", whiteSpace:"nowrap" }}>
                          <button onClick={() => openMockEdit(m)} style={{ background:"#e0f2fe", color:"#0284c7", border:"none", borderRadius:6, padding:"5px 9px", cursor:"pointer", fontSize:13, marginRight:4 }}>✏️</button>
                          <button onClick={() => setDelItem({ kind:"mock", item:m })} style={{ background:"#fef2f2", color:"#dc2626", border:"none", borderRadius:6, padding:"5px 9px", cursor:"pointer", fontSize:13 }}>🗑️</button>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {/* ══ CALENDAR ══ */}
        {tab === "cal" && (
          <div>
            <div style={{ display:"grid", gridTemplateColumns:"repeat(2,1fr)", gap:18 }}>
              {Array.from({ length: 4 }).map((_, idx) => {
                const d0 = new Date(); d0.setDate(1); d0.setMonth(d0.getMonth() + idx);
                const m = d0.getMonth(), y = d0.getFullYear();
                const label = d0.toLocaleDateString("en-IN", { month:"long", year:"numeric" });
                const items = topics.filter(x => { const d = new Date(x.target); return d.getMonth() === m && d.getFullYear() === y; }).sort((a, b) => new Date(a.target) - new Date(b.target));
                return (
                  <div key={idx} style={card}>
                    <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", marginBottom:16 }}>
                      <h3 style={{ margin:0, fontSize:15, fontWeight:800, color:"#0f172a" }}>📅 {label}</h3>
                      <span style={{ background:"#e0f2fe", color:"#0284c7", borderRadius:8, padding:"3px 10px", fontSize:11, fontWeight:700 }}>{items.length} targets</span>
                    </div>
                    {items.length === 0 ? (
                      <div style={{ color:"#94a3b8", textAlign:"center", padding:"24px 0", fontSize:13 }}>No target dates this month</div>
                    ) : items.map((x, i) => {
                      const d = new Date(x.target);
                      const sc = ST[x.status];
                      return (
                        <div key={i} onClick={() => openEdit(x)} style={{ display:"flex", gap:12, padding:"10px 8px", borderBottom:"1px solid #f1f5f9", alignItems:"flex-start", cursor:"pointer", borderRadius:8 }}>
                          <div style={{ flexShrink:0, width:38, textAlign:"center", background:"#f8fafc", borderRadius:8, padding:"4px 0" }}>
                            <div style={{ fontWeight:900, fontSize:18, color:"#0f172a", lineHeight:1 }}>{d.getDate()}</div>
                          </div>
                          <div style={{ flex:1 }}>
                            <div style={{ fontSize:12, fontWeight:600, color:"#111827" }}>{x.topic}</div>
                            <div style={{ display:"flex", gap:5, marginTop:4, flexWrap:"wrap" }}>
                              <SubjectBadge subject={x.subject} />
                              <span style={{ background:sc.bg, color:sc.color, borderRadius:4, padding:"1px 6px", fontSize:9, fontWeight:700 }}>{sc.icon} {sc.label}</span>
                            </div>
                          </div>
                          <DaysChip due={x.target} status={x.status} />
                        </div>
                      );
                    })}
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* ══ REPORT ══ */}
        {tab === "report" && (
          <div style={{ maxWidth:880, margin:"0 auto" }}>
            <div style={{ ...card, padding:0, overflow:"hidden", boxShadow:"0 8px 40px rgba(0,0,0,0.13)" }}>
              <div style={{ background:"linear-gradient(135deg,#0f172a,#1e3a5f,#164e63)", padding:"48px 56px", textAlign:"center" }}>
                <div style={{ fontSize:40 }}>📚</div>
                <div style={{ color:"#fff", fontSize:26, fontWeight:900, marginTop:14, letterSpacing:"-0.5px" }}>EXAM PREPARATION REPORT</div>
                <div style={{ color:"#7dd3fc", fontSize:14, marginTop:6 }}>{examName}</div>
                <div style={{ color:"#60a5fa", fontSize:12, marginTop:3 }}>Exam Date: {fmtDate(examDate)} · {daysLeft >= 0 ? `${daysLeft} days remaining` : "Exam complete"}</div>
                <div style={{ display:"inline-block", marginTop:20, background: readiness >= 75 ? "#059669" : readiness >= 50 ? "#d97706" : "#dc2626", color:"#fff", borderRadius:30, padding:"10px 32px", fontWeight:900, fontSize:22 }}>
                  Readiness Score: {readiness}%
                </div>
              </div>
              <div style={{ padding:"40px 56px" }}>
                <h3 style={{ fontSize:13, fontWeight:800, color:"#0f172a", borderBottom:"2px solid #e2e8f0", paddingBottom:8, marginBottom:16 }}>I. SUBJECT-WISE PROGRESS</h3>
                <table style={{ width:"100%", borderCollapse:"collapse", fontSize:12, marginBottom:32 }}>
                  <thead>
                    <tr style={{ background:"#f8fafc" }}>
                      {["Subject", "Total", "Mastered", "In Progress/Revision", "Not Started", "Score"].map(h => (
                        <th key={h} style={{ padding:"9px 13px", textAlign: h === "Subject" ? "left" : "center", fontSize:10, fontWeight:700, color:"#64748b", border:"1px solid #e2e8f0" }}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {subjectStats.map(({ s, total, mastered, score }) => {
                      const r = topics.filter(x => x.subject === s);
                      const inprog = r.filter(x => x.status === "inprogress" || x.status === "revision").length;
                      const notst = r.filter(x => x.status === "notstarted").length;
                      return (
                        <tr key={s}>
                          <td style={{ padding:"9px 13px", border:"1px solid #e2e8f0", fontWeight:800, color:colorFor(s).color }}>{s}</td>
                          <td style={{ padding:"9px 13px", border:"1px solid #e2e8f0", textAlign:"center" }}>{total}</td>
                          <td style={{ padding:"9px 13px", border:"1px solid #e2e8f0", textAlign:"center" }}>{mastered}</td>
                          <td style={{ padding:"9px 13px", border:"1px solid #e2e8f0", textAlign:"center" }}>{inprog}</td>
                          <td style={{ padding:"9px 13px", border:"1px solid #e2e8f0", textAlign:"center" }}>{notst}</td>
                          <td style={{ padding:"9px 13px", border:"1px solid #e2e8f0", textAlign:"center", fontWeight:800, color: score >= 75 ? "#059669" : score >= 50 ? "#d97706" : "#dc2626" }}>{score}%</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>

                {topics.filter(x => x.priority === "High" && x.status !== "mastered").length > 0 && (
                  <>
                    <h3 style={{ fontSize:13, fontWeight:800, color:"#dc2626", borderBottom:"2px solid #fee2e2", paddingBottom:8, marginBottom:16 }}>II. HIGH-PRIORITY PENDING TOPICS</h3>
                    {topics.filter(x => x.priority === "High" && x.status !== "mastered").map(t => (
                      <div key={t.id} style={{ background:"#fef2f2", border:"1px solid #fecaca", borderRadius:10, padding:"12px 16px", marginBottom:10 }}>
                        <div style={{ display:"flex", justifyContent:"space-between" }}>
                          <span style={{ fontWeight:700, fontSize:12, color:"#991b1b" }}>{t.topic}</span>
                          <SubjectBadge subject={t.subject} />
                        </div>
                        <div style={{ fontSize:11, color:"#6b7280", marginTop:3 }}>Target: {fmtDate(t.target)} · {t.notes}</div>
                      </div>
                    ))}
                    <div style={{ marginBottom:24 }} />
                  </>
                )}

                <h3 style={{ fontSize:13, fontWeight:800, color:"#0f172a", borderBottom:"2px solid #e2e8f0", paddingBottom:8, marginBottom:16 }}>III. MOCK TEST SUMMARY</h3>
                {sortedMocks.length === 0 ? <div style={{ color:"#94a3b8", fontSize:12, marginBottom:24 }}>No mock tests logged yet.</div> : (
                  <table style={{ width:"100%", borderCollapse:"collapse", fontSize:11, marginBottom:24 }}>
                    <thead>
                      <tr style={{ background:"#f8fafc" }}>
                        {["Test", "Date", "Score", "%"].map(h => <th key={h} style={{ padding:"7px 11px", textAlign:"left", fontWeight:700, color:"#64748b", border:"1px solid #e2e8f0", fontSize:10 }}>{h}</th>)}
                      </tr>
                    </thead>
                    <tbody>
                      {sortedMocks.map((m, i) => (
                        <tr key={m.id} style={{ background: i % 2 === 0 ? "#fff" : "#fafbfc" }}>
                          <td style={{ padding:"7px 11px", border:"1px solid #e2e8f0", fontWeight:600 }}>{m.name}</td>
                          <td style={{ padding:"7px 11px", border:"1px solid #e2e8f0" }}>{fmtDate(m.date)}</td>
                          <td style={{ padding:"7px 11px", border:"1px solid #e2e8f0" }}>{m.score}/{m.max}</td>
                          <td style={{ padding:"7px 11px", border:"1px solid #e2e8f0", fontWeight:700 }}>{Math.round((m.score / m.max) * 100)}%</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}

                <div style={{ marginTop:24, borderTop:"2px solid #e2e8f0", paddingTop:20, fontSize:11, color:"#94a3b8", textAlign:"center" }}>
                  Report generated on {fmtDate(todayISO())} · Study hours logged: {hoursLogged}h
                </div>
              </div>
            </div>
            <div style={{ textAlign:"center", marginTop:18 }}>
              <button onClick={() => window.print()} style={{ background:"#0f172a", color:"#fff", border:"none", borderRadius:10, padding:"12px 32px", fontSize:13, fontWeight:700, cursor:"pointer" }}>🖨️ Print / Export Report</button>
            </div>
          </div>
        )}
      </div>

      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&display=swap');
        *{box-sizing:border-box;} body{margin:0;}
        @keyframes slideUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
        select{outline:none;} input:focus{outline:2px solid #0284c7;outline-offset:1px;}
        ::-webkit-scrollbar{width:5px;height:5px} ::-webkit-scrollbar-track{background:#f1f5f9}
        ::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:99px}
        @media print{button{display:none!important}}
      `}</style>
    </div>
  );
}
