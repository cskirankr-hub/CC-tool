                        <td style={{ padding:"10px 12px", borderBottom:"1px solid #f1f5f9", textAlign:"center", whiteSpace:"nowrap" }}>
                          <button onClick={() => openEdit(t)} style={{ background:"#e0f2fe", color:"#0284c7", border:"none", borderRadius:6, padding:"5px 9px", cursor:"pointer", fontSize:13, marginRight:4 }} title="Edit">✏️</button>
