  const TH = ({ children, center }) => (
    <th style={{ padding:"10px 14px", textAlign: center ? "center" : "left", fontSize:10, fontWeight:700, color:"#94a3b8", letterSpacing:"0.6px", textTransform:"uppercase", background:"#f8fafc", borderBottom:"2px solid #e2e8f0", whiteSpace:"nowrap" }}>{children}</th>
  );

  return (
    <div style={{ fontFamily:"'Outfit','DM Sans',sans-serif", background:"#f0f4f8", minHeight:"100vh", color:"#1e293b" }}>
      {toast && (
        <div style={{ position:"fixed", top:20, right:24, zIndex:2000,
          background: toast.type === "error" ? "#fef2f2" : "#f0fdf4",
          border:`1.5px solid ${toast.type === "error" ? "#fecaca" : "#bbf7d0"}`,
          borderRadius:12, padding:"12px 20px", boxShadow:"0 8px 24px rgba(0,0,0,0.12)",
          fontSize:13, fontWeight:600, color: toast.type === "error" ? "#991b1b" : "#166534", maxWidth:360 }}>
          {toast.msg}
        </div>
      )}

      {(modal === "add" || typeof modal === "number") && (
        <TopicModal form={form} setForm={setForm} subjects={subjects} onSave={saveTopic} onClose={closeModal} isEdit={modal !== "add"} />
