// ── INLINE EDIT CELL ──────────────────────────────────────────────────────────
function EditCell({ value, onChange, type="text", options }) {
  const [editing, setEditing] = useState(false);
  const [val, setVal] = useState(value);
  const ref = useRef();

  const commit = () => { onChange(val); setEditing(false); };
  if (!editing) return (
    <span onClick={()=>setEditing(true)}
      style={{cursor:"text",borderRadius:5,padding:"2px 5px",display:"inline-block",
        border:"1px dashed transparent",transition:"border-color 0.15s",minWidth:40,
        fontSize:12,color:"#374151"}}
      onMouseEnter={e=>e.target.style.borderColor="#cbd5e1"}
      onMouseLeave={e=>e.target.style.borderColor="transparent"}>
      {value||<span style={{color:"#94a3b8",fontStyle:"italic"}}>click to edit</span>}
    </span>
  );
  if (options) return (
    <select ref={ref} autoFocus value={val} onChange={e=>setVal(e.target.value)} onBlur={commit}
      style={{border:"1.5px solid #4f46e5",borderRadius:6,padding:"3px 6px",fontSize:11,background:"#fff",outline:"none"}}>
      {options.map(o=><option key={o.v} value={o.v}>{o.l}</option>)}
    </select>
  );
  if (type==="date") return (
    <input ref={ref} autoFocus type="date" value={val} onChange={e=>setVal(e.target.value)} onBlur={commit}
      onKeyDown={e=>e.key==="Enter"&&commit()}
      style={{border:"1.5px solid #4f46e5",borderRadius:6,padding:"3px 7px",fontSize:11,outline:"none"}}/>
  );
  return (
    <input ref={ref} autoFocus value={val} onChange={e=>setVal(e.target.value)} onBlur={commit}
      onKeyDown={e=>e.key==="Enter"&&commit()}
      style={{border:"1.5px solid #4f46e5",borderRadius:6,padding:"3px 7px",fontSize:11,outline:"none",width:"100%",minWidth:120}}/>
  );
}

